@model List<AboutListViewModel>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/_AdminLayout.cshtml";
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container">
    <br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Başlık</th>
            <th>Alt Başlık</th>
            <th>Açıklama</th>
            <th>Güncelle</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AboutID</td>
                <td>@item.Title</td>
                <td>@item.SubTitle</td>
                <td>@(item.Description.Length>50 ? 
                    item.Description.Substring(0,50)+ "..."
                    : item.Description
                     )</td>
                <td><a href="/About/UpdateAbout/@item.AboutID" class="btn btn-primary">Güncelle</a></td>
            </tr>
        }
    </table>
</div>

